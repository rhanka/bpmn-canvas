  <bpmn:collaboration id="Sales_overview_collab">
    <bpmn:participant id="Sales_overview_pool" name="Sales overview" processRef="Sales_overview" />
  </bpmn:collaboration>
  <bpmn:process id="Sales_overview" name="Sales overview" isExecutable="false">
    <bpmn:laneSet id="Sales_overview_lanes">
      <bpmn:lane id="Desk" name="Desk">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quote_preparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Run_2_1_checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tape2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:extensionElements>
        <sem:info order="0" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Quote_preparation</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Quote_preparation" name="Quote preparation">
      <bpmn:extensionElements>
        <sem:info order="1" processRef="Quote_preparation_2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Quote_preparation</bpmn:incoming>
      <bpmn:outgoing>Flow_Quote_preparation_Run_2_1_checks</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:callActivity id="Run_2_1_checks" name="Run 2.1 checks" calledElement="Process_2_1_Credit_check">
      <bpmn:extensionElements>
        <sem:info order="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Quote_preparation_Run_2_1_checks</bpmn:incoming>
      <bpmn:outgoing>Flow_Run_2_1_checks_Archive</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Archive" name="Archive">
      <bpmn:extensionElements>
        <sem:info order="3" processRef="Archive_records" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Run_2_1_checks_Archive</bpmn:incoming>
      <bpmn:outgoing>Flow_Archive__tape2_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="tape2_1" name="Étape2.1">
      <bpmn:extensionElements>
        <sem:info order="4" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Archive__tape2_1</bpmn:incoming>
      <bpmn:outgoing>Flow__tape2_1_Done</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="Done" name="Done">
      <bpmn:extensionElements>
        <sem:info order="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow__tape2_1_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Quote_preparation" sourceRef="Start" targetRef="Quote_preparation">
      <bpmn:extensionElements>
        <sem:info order="1000" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Quote_preparation_Run_2_1_checks" sourceRef="Quote_preparation" targetRef="Run_2_1_checks">
      <bpmn:extensionElements>
        <sem:info order="1001" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Run_2_1_checks_Archive" sourceRef="Run_2_1_checks" targetRef="Archive">
      <bpmn:extensionElements>
        <sem:info order="1002" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
