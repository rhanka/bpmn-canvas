      <bpmn:extensionElements>
        <sem:info order="1003" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow__tape2_1_Done" sourceRef="tape2_1" targetRef="Done">
      <bpmn:extensionElements>
        <sem:info order="1004" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="Quote_preparation_collab">
