<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="test-builder">
  <bpmn:collaboration id="Team_work_collab">
    <bpmn:participant id="Team_work_pool" name="Team work" processRef="Team_work" />
  </bpmn:collaboration>
  <bpmn:process id="Team_work" name="Team work" isExecutable="false">
    <bpmn:laneSet id="Team_work_lanes">
      <bpmn:lane id="Team" name="Team">
        <bpmn:flowNodeRef>Kick_off</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Plan_work</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane" name="">
        <bpmn:flowNodeRef>Draft</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Team_2" name="Team">
        <bpmn:flowNodeRef>Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Kick_off" name="Kick-off">
      <bpmn:outgoing>Flow_Kick_off_Plan_work</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Plan_work" name="Plan work">
      <bpmn:incoming>Flow_Kick_off_Plan_work</bpmn:incoming>
      <bpmn:outgoing>Flow_Plan_work_Draft</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Draft" name="Draft">
      <bpmn:incoming>Flow_Plan_work_Draft</bpmn:incoming>
      <bpmn:outgoing>Flow_Draft_Build</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="Checklist_obj" />
    <bpmn:dataObjectReference id="Checklist" name="Checklist" dataObjectRef="Checklist_obj" />
    <bpmn:dataObject id="Spec_obj" />
    <bpmn:dataObjectReference id="Spec" name="Spec" dataObjectRef="Spec_obj" />
    <bpmn:task id="Build" name="Build">
      <bpmn:incoming>Flow_Draft_Build</bpmn:incoming>
      <bpmn:outgoing>Flow_Build_Delivered</bpmn:outgoing>
      <bpmn:property id="Build_in_Spec" name="__targetRef_placeholder" />
      <bpmn:property id="Build_in_Checklist" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="In_Spec_Build">
        <bpmn:sourceRef>Spec</bpmn:sourceRef>
        <bpmn:targetRef>Build_in_Spec</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="In_Checklist_Build">
        <bpmn:sourceRef>Checklist</bpmn:sourceRef>
        <bpmn:targetRef>Build_in_Checklist</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="Delivered" name="Delivered">
      <bpmn:incoming>Flow_Build_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Kick_off_Plan_work" sourceRef="Kick_off" targetRef="Plan_work" />
    <bpmn:sequenceFlow id="Flow_Plan_work_Draft" sourceRef="Plan_work" targetRef="Draft" />
    <bpmn:sequenceFlow id="Flow_Draft_Build" sourceRef="Draft" targetRef="Build" />
    <bpmn:sequenceFlow id="Flow_Build_Delivered" sourceRef="Build" targetRef="Delivered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Team_work_diagram" name="Team work">
    <bpmndi:BPMNPlane id="Team_work_plane" bpmnElement="Team_work_collab">
      <bpmndi:BPMNShape id="Team_work_pool_di" bpmnElement="Team_work_pool" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="968" height="614" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Team_di" bpmnElement="Team" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="938" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_di" bpmnElement="Lane" isHorizontal="true">
        <dc:Bounds x="30" y="200" width="938" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Team_2_di" bpmnElement="Team_2" isHorizontal="true">
        <dc:Bounds x="30" y="400" width="938" height="214" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Kick_off_di" bpmnElement="Kick_off">
        <dc:Bounds x="100" y="41" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="105" y="95" width="41" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Plan_work_di" bpmnElement="Plan_work">
        <dc:Bounds x="220" y="26" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Draft_di" bpmnElement="Draft">
        <dc:Bounds x="410" y="226" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Checklist_di" bpmnElement="Checklist">
        <dc:Bounds x="604" y="520" width="40" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="574" width="49" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Spec_di" bpmnElement="Spec">
        <dc:Bounds x="659" y="520" width="40" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="574" width="30" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Build_di" bpmnElement="Build">
        <dc:Bounds x="657" y="426" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Delivered_di" bpmnElement="Delivered">
        <dc:Bounds x="847" y="441" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="847" y="495" width="51" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Kick_off_Plan_work_di" bpmnElement="Flow_Kick_off_Plan_work">
        <di:waypoint x="150" y="66" />
        <di:waypoint x="220" y="66" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Plan_work_Draft_di" bpmnElement="Flow_Plan_work_Draft">
        <di:waypoint x="340" y="66" />
        <di:waypoint x="375" y="66" />
        <di:waypoint x="375" y="266" />
        <di:waypoint x="410" y="266" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Draft_Build_di" bpmnElement="Flow_Draft_Build">
        <di:waypoint x="530" y="266" />
        <di:waypoint x="565" y="266" />
        <di:waypoint x="565" y="466" />
        <di:waypoint x="657" y="466" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Build_Delivered_di" bpmnElement="Flow_Build_Delivered">
        <di:waypoint x="777" y="466" />
        <di:waypoint x="847" y="466" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="In_Spec_Build_di" bpmnElement="In_Spec_Build">
        <di:waypoint x="679" y="520" />
        <di:waypoint x="679" y="506" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="In_Checklist_Build_di" bpmnElement="In_Checklist_Build">
        <di:waypoint x="624" y="520" />
        <di:waypoint x="624" y="513" />
        <di:waypoint x="665" y="513" />
        <di:waypoint x="665" y="506" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
