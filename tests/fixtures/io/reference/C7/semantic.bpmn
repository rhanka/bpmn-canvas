      <bpmn:extensionElements>
        <sem:info order="8" laneRef="Unit" direction="out" primaryAssociationRef="Out_Assemble_Out_two" />
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
    <bpmn:endEvent id="Stop" name="Stop">
      <bpmn:extensionElements>
        <sem:info order="9" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Assemble_Stop</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Go_Assemble" sourceRef="Go" targetRef="Assemble">
      <bpmn:extensionElements>
        <sem:info order="1000" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Assemble_Stop" sourceRef="Assemble" targetRef="Stop">
      <bpmn:extensionElements>
        <sem:info order="1001" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Doc_Doc_one">
      <bpmn:extensionElements>
        <sem:info order="2" laneRef="Unit" primaryAssociationRef="DocLink_Doc_one_Assemble" />
      </bpmn:extensionElements>
      <bpmn:text>[Doc] Doc one</bpmn:text>
