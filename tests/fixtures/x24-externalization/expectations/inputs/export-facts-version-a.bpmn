<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xf="urn:x24:facts:2" id="Defs" targetNamespace="urn:x24:export">
  <bpmn:collaboration id="C1">
    <bpmn:participant id="Pool1" name="Intake" processRef="P1"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="false">
    <bpmn:laneSet id="LS_P1">
      <bpmn:lane id="L1" name="Desk">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="In"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="T1" name="Review"><bpmn:extensionElements><xf:facts seq="1"/></bpmn:extensionElements><bpmn:incoming>F1</bpmn:incoming></bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P1">
    <bpmndi:BPMNPlane id="Plane_D_P1" bpmnElement="C1">
      <bpmndi:BPMNShape id="Pool1_di" bpmnElement="Pool1" isHorizontal="true"><dc:Bounds x="0" y="0" width="400" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true"><dc:Bounds x="30" y="0" width="370" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="80" y="82" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="160" y="60" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="116" y="100"/><di:waypoint x="160" y="100"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
