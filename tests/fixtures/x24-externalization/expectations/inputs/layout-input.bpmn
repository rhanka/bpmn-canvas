<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs" targetNamespace="urn:x24:layout">
  <bpmn:process id="P1" name="Intake" isExecutable="false">
    <bpmn:laneSet id="LS1">
      <bpmn:lane id="L1" name="Desk">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="In"/>
    <bpmn:task id="T1" name="Review">
      <bpmn:dataInputAssociation id="DIA1">
        <bpmn:sourceRef>D1</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Ok?"/>
    <bpmn:endEvent id="E1" name="Out"/>
    <bpmn:dataObjectReference id="D1" name="Form" dataObjectRef="DO1"/>
    <bpmn:dataObject id="DO1"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1"/>
    <bpmn:sequenceFlow id="F3" name="yes" sourceRef="G1" targetRef="E1"/>
    <bpmn:textAnnotation id="N1"><bpmn:text>[Binder] Guide</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>[Gadget] ledger</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N3"><bpmn:text>[Aid] planner</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N4"><bpmn:text>[Folio] Manual</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N5"><bpmn:text>[Note] tracker</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N6"><bpmn:text>[Leaf] Handbook</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N7"><bpmn:text>plain remark</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A1" sourceRef="N1" targetRef="T1"/>
    <bpmn:association id="A2" sourceRef="N2" targetRef="T1"/>
    <bpmn:association id="A3" sourceRef="N3" targetRef="T1"/>
    <bpmn:association id="A4" sourceRef="N4" targetRef="T1"/>
    <bpmn:association id="A5" sourceRef="N5" targetRef="T1"/>
    <bpmn:association id="A6" sourceRef="N6" targetRef="T1"/>
    <bpmn:association id="A7" sourceRef="N7" targetRef="T1"/>
  </bpmn:process>
</bpmn:definitions>
