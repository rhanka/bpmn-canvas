<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="test-builder">
  <bpmn:collaboration id="Service_desk_collab">
    <bpmn:participant id="Service_desk_pool" name="Service desk" processRef="Service_desk" />
  </bpmn:collaboration>
  <bpmn:process id="Service_desk" name="Service desk" isExecutable="false">
    <bpmn:laneSet id="Service_desk_lanes">
      <bpmn:lane id="Front_desk" name="Front desk">
        <bpmn:flowNodeRef>Request_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Log_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Back_office" name="Back office">
        <bpmn:flowNodeRef>Resolve_issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Escalate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Request_in" name="Request in">
      <bpmn:outgoing>Flow_Request_in_Log_request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:dataObject id="Request_form_obj" />
    <bpmn:dataObjectReference id="Request_form" name="Request form" dataObjectRef="Request_form_obj" />
    <bpmn:task id="Log_request" name="Log request">
      <bpmn:incoming>Flow_Request_in_Log_request</bpmn:incoming>
      <bpmn:outgoing>Flow_Log_request_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome</bpmn:outgoing>
      <bpmn:property id="Log_request_in_Request_form" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="In_Request_form_Log_request">
        <bpmn:sourceRef>Request_form</bpmn:sourceRef>
        <bpmn:targetRef>Log_request_in_Request_form</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Out_Log_request_Ticket">
        <bpmn:targetRef>Ticket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObject id="Ticket_obj" />
    <bpmn:dataObjectReference id="Ticket" name="Ticket" dataObjectRef="Ticket_obj" />
    <bpmn:task id="Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome" name="Check the incoming request against all the applicable rules and record the outcome">
      <bpmn:incoming>Flow_Log_request_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_Valid</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Valid?">
      <bpmn:incoming>Flow_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid__Request_done</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid__Resolve_issue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Request_done" name="Request done">
      <bpmn:incoming>Flow_Valid__Request_done</bpmn:incoming>
      <bpmn:incoming>Flow_Escalate_Request_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Resolve_issue" name="Resolve issue">
      <bpmn:incoming>Flow_Valid__Resolve_issue</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_issue_Escalate</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:callActivity id="Escalate" name="Escalate">
      <bpmn:incoming>Flow_Resolve_issue_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_Request_done</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_Request_in_Log_request" sourceRef="Request_in" targetRef="Log_request" />
    <bpmn:sequenceFlow id="Flow_Log_request_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome" sourceRef="Log_request" targetRef="Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome" />
    <bpmn:sequenceFlow id="Flow_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_Valid" sourceRef="Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid__Request_done" name="yes" sourceRef="Valid" targetRef="Request_done" />
    <bpmn:sequenceFlow id="Flow_Valid__Resolve_issue" name="no" sourceRef="Valid" targetRef="Resolve_issue" />
    <bpmn:sequenceFlow id="Flow_Resolve_issue_Escalate" sourceRef="Resolve_issue" targetRef="Escalate" />
    <bpmn:sequenceFlow id="Flow_Escalate_Request_done" sourceRef="Escalate" targetRef="Request_done" />
    <bpmn:textAnnotation id="Doc_Desk_manual">
      <bpmn:text>[Reference] Desk manual</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="DocLink_Desk_manual_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome" associationDirection="One" sourceRef="Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome" targetRef="Doc_Desk_manual" />
    <bpmn:textAnnotation id="App_Log_request">
      <bpmn:text>[Component] Ticket tool</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AppLink_Log_request" sourceRef="App_Log_request" targetRef="Log_request" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Service_desk_diagram" name="Service desk">
    <bpmndi:BPMNPlane id="Service_desk_plane" bpmnElement="Service_desk_collab">
      <bpmndi:BPMNShape id="Service_desk_pool_di" bpmnElement="Service_desk_pool" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1304" height="499" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Front_desk_di" bpmnElement="Front_desk" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1274" height="299" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Back_office_di" bpmnElement="Back_office" isHorizontal="true">
        <dc:Bounds x="30" y="299" width="1274" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Request_in_di" bpmnElement="Request_in">
        <dc:Bounds x="103" y="106" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="160" width="57" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Request_form_di" bpmnElement="Request_form">
        <dc:Bounds x="242" y="205" width="40" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="227" y="259" width="71" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Log_request_di" bpmnElement="Log_request">
        <dc:Bounds x="292" y="91" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ticket_di" bpmnElement="Ticket">
        <dc:Bounds x="406" y="205" width="40" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="409" y="259" width="34" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_di" bpmnElement="Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome">
        <dc:Bounds x="546" y="91" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Doc_Desk_manual_di" bpmnElement="Doc_Desk_manual">
        <dc:Bounds x="516" y="26" width="120" height="51" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid">
        <dc:Bounds x="816" y="106" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="824" y="160" width="35" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Request_done_di" bpmnElement="Request_done">
        <dc:Bounds x="971" y="106" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="160" width="73" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Resolve_issue_di" bpmnElement="Resolve_issue">
        <dc:Bounds x="936" y="325" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalate_di" bpmnElement="Escalate">
        <dc:Bounds x="1126" y="334" width="108" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Request_in_Log_request_di" bpmnElement="Flow_Request_in_Log_request">
        <di:waypoint x="153" y="131" />
        <di:waypoint x="292" y="131" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Log_request_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_di" bpmnElement="Flow_Log_request_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome">
        <di:waypoint x="412" y="131" />
        <di:waypoint x="546" y="131" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_Valid_di" bpmnElement="Flow_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_Valid">
        <di:waypoint x="746" y="131" />
        <di:waypoint x="816" y="131" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid__Request_done_di" bpmnElement="Flow_Valid__Request_done">
        <di:waypoint x="866" y="131" />
        <di:waypoint x="971" y="131" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="907" y="113" width="22" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid__Resolve_issue_di" bpmnElement="Flow_Valid__Resolve_issue">
        <di:waypoint x="866" y="131" />
        <di:waypoint x="901" y="131" />
        <di:waypoint x="901" y="365" />
        <di:waypoint x="936" y="365" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="915" y="347" width="17" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Resolve_issue_Escalate_di" bpmnElement="Flow_Resolve_issue_Escalate">
        <di:waypoint x="1056" y="365" />
        <di:waypoint x="1126" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalate_Request_done_di" bpmnElement="Flow_Escalate_Request_done">
        <di:waypoint x="1180" y="334" />
        <di:waypoint x="1180" y="8" />
        <di:waypoint x="996" y="8" />
        <di:waypoint x="996" y="106" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="In_Request_form_Log_request_di" bpmnElement="In_Request_form_Log_request">
        <di:waypoint x="262" y="205" />
        <di:waypoint x="262" y="198" />
        <di:waypoint x="312" y="198" />
        <di:waypoint x="312" y="191" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Out_Log_request_Ticket_di" bpmnElement="Out_Log_request_Ticket">
        <di:waypoint x="392" y="191" />
        <di:waypoint x="392" y="198" />
        <di:waypoint x="426" y="198" />
        <di:waypoint x="426" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DocLink_Desk_manual_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome_di" bpmnElement="DocLink_Desk_manual_Check_the_incoming_request_against_all_the_applicable_rules_and_record_the_outcome">
        <di:waypoint x="576" y="77" />
        <di:waypoint x="576" y="91" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="App_Log_request_di" bpmnElement="App_Log_request">
        <dc:Bounds x="306" y="161" width="92" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="AppLink_Log_request_di" bpmnElement="AppLink_Log_request">
        <di:waypoint x="352" y="161" />
        <di:waypoint x="352" y="165" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
