          "$type": "bpmn:DataObject",
          "id": "Obj_1"
        },
        {
          "$type": "bpmn:CallActivity",
          "id": "Call_1",
          "name": "Run review",
          "calledElement": "Proc-review",
          "documentation": [
            {
              "$type": "bpmn:Documentation",
              "text": "Source: review procedure, step 4"
            }
          ]
        },
        {
          "$type": "bpmn:CallActivity",
          "id": "Call_2",
          "name": "Révision cycle",
          "calledElement": "ProcArchive"
        },
        {
          "$type": "bpmn:Task",
          "id": "Task_X",
