<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://example.org/layout">
  <bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Pool" processRef="Proc"/></bpmn:collaboration>
  <bpmn:process id="Proc" name="Boundary" isExecutable="false">
    <bpmn:startEvent id="Start"/>
    <bpmn:task id="Work" name="Do the work"/>
    <bpmn:boundaryEvent id="Timer" name="Late" attachedToRef="Work"><bpmn:timerEventDefinition id="TD"/></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Esc" attachedToRef="Work"><bpmn:escalationEventDefinition id="ED"/></bpmn:boundaryEvent>
    <bpmn:task id="Handle" name="Handle delay"/>
    <bpmn:endEvent id="Done"/>
    <bpmn:endEvent id="Late_end"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Work"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Work" targetRef="Done"/>
    <bpmn:sequenceFlow id="FB" name="timeout" sourceRef="Timer" targetRef="Handle"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Handle" targetRef="Late_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia"><bpmndi:BPMNPlane id="Pl" bpmnElement="Collab">
    <bpmndi:BPMNShape id="dPool" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="20" y="20" width="1200" height="400"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dStart" bpmnElement="Start"><dc:Bounds x="700" y="300" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dWork" bpmnElement="Work"><dc:Bounds x="100" y="120" width="140" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dTimer" bpmnElement="Timer"><dc:Bounds x="152" y="192" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dEsc" bpmnElement="Esc"><dc:Bounds x="222" y="124" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dHandle" bpmnElement="Handle"><dc:Bounds x="500" y="320" width="120" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dDone" bpmnElement="Done"><dc:Bounds x="900" y="60" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="dLate" bpmnElement="Late_end"><dc:Bounds x="1100" y="340" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="dF1" bpmnElement="F1"><di:waypoint x="736" y="318"/><di:waypoint x="240" y="165"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="dF2" bpmnElement="F2"><di:waypoint x="240" y="165"/><di:waypoint x="900" y="78"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="dFB" bpmnElement="FB"><di:waypoint x="170" y="228"/><di:waypoint x="500" y="360"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="dF3" bpmnElement="F3"><di:waypoint x="620" y="360"/><di:waypoint x="1100" y="358"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
