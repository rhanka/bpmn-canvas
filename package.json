{
  "name": "@sentropic/bpmn-canvas",
  "version": "0.2.0-local",
  "description": "Framework-independent BPMN 2.0 editing canvas built on bpmn-js, with React and assistant-ui adapters.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/internal/styles.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/bpmn-canvas.iife.min.js",
  "jsdelivr": "./dist/browser/bpmn-canvas.iife.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui/index.d.ts",
      "import": "./dist/assistant-ui/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./browser": {
      "types": "./dist/browser/entry.d.ts",
      "import": "./dist/browser/bpmn-canvas.min.js"
    },
    "./browser/iife": "./dist/browser/bpmn-canvas.iife.min.js"
  },
  "files": [
    "dist/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/**",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "gen": "node scripts/gen-css.mjs",
    "build": "npm run clean && npm run gen && tsc -p tsconfig.build.json && node scripts/build-assets.mjs && node scripts/build-browser.mjs",
    "typecheck": "npm run gen && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "e3": "node experiments/e3/run.mjs",
    "typecheck:compat": "tsc -p tests/types/tsconfig.json"
  },
  "dependencies": {
    "bpmn-auto-layout": "1.3.0",
    "bpmn-js": "~18.30.1",
    "bpmn-moddle": "~10.3.1",
    "diagram-js": "~15.27.1",
    "tiny-svg": "~4.1.4"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "xmllint-wasm": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
